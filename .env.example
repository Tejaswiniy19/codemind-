# Safe local defaults. Compose also supplies these when this file is absent.
CODEMIND_BIND=127.0.0.1
CODEMIND_COOKIE_SECURE=false
CODEMIND_DATA_VOLUME=codemind_codemind-data

# Upload and analysis bounds.
CODEMIND_MAX_ARCHIVE_BYTES=104857600
CODEMIND_MAX_EXPANDED_BYTES=524288000
CODEMIND_MAX_FILES=20000
CODEMIND_MAX_SOURCE_PREVIEW_BYTES=524288
CODEMIND_MAX_ANALYSIS_FILE_BYTES=524288
CODEMIND_MAX_TOTAL_ANALYSIS_BYTES=67108864
CODEMIND_MAX_ANALYSIS_FILES=20000

# Optional stable session key. Leave unset to generate and store a key in the
# private SQLite data volume. If set, use a random value of at least 32 bytes.
# CODEMIND_SESSION_SECRET=

# Optional: set these only after operating a compatible, isolated HTTPS runner.
# The bearer token is passed only to the Compose worker, never to the API/web.
# CODEMIND_RUNNER_URL=https://runner.example.com
# CODEMIND_RUNNER_TOKEN=
# CODEMIND_DEPLOYMENT_DOMAINS=apps.example.com

# Optional source-grounded Q&A. This must point to a local/private
# OpenAI-compatible endpoint; source is never sent to a hosted model by default.
# For Ollama in Docker Desktop, use http://host.docker.internal:11434/v1
# CODEMIND_LLM_BASE_URL=
# CODEMIND_LLM_MODEL=qwen2.5-coder:7b
# CODEMIND_LLM_TIMEOUT_SECONDS=45
